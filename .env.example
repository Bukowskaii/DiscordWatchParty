# =============================================================================
# DiscordWatchParty — environment configuration (bot host only)
#
# Media server credentials are NOT configured here. After adding the bot to
# a Discord server, a server admin runs /setup configure to connect their
# Plex, Jellyfin, or Emby server. Credentials are stored per-server in
# data/guild_configs.db on this machine.
# =============================================================================


# ── Step 1: Discord ───────────────────────────────────────────────────────────
#
# 1. Go to https://discord.com/developers/applications and create an application.
# 2. Under Bot, create a bot and copy the token below.
# 3. Under OAuth2 → General, copy the Client ID (the application ID).
# 4. Invite the bot with the bot + applications.commands scopes.
# 5. Run:  npm run deploy-commands

DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# 256-bit key used to encrypt guild API keys at rest in the SQLite database.
# Generate one with:  npm run generate-key
# Keep this secret and backed up — losing it means existing configs can't be decrypted.
ENCRYPTION_KEY=


# ── Step 2: Public access ─────────────────────────────────────────────────────
#
# PUBLIC_URL is embedded in every watch link the bot posts. It must match the
# public hostname your Cloudflare Tunnel exposes — no trailing slash.
#
# Cloudflare Tunnel: add a public hostname pointing to http://localhost:8780
# (or whatever NGINX_PORT is set to), then paste the https://... URL below.

PUBLIC_URL=https://your-tunnel.example.com

# Port nginx listens on. Point your Cloudflare Tunnel (or other proxy) here.
NGINX_PORT=8780


# ── Step 3: Optional tweaks ───────────────────────────────────────────────────

# How long a watch-session link stays valid (minutes). Default: 6 hours.
SESSION_TTL_MINUTES=360
